{
  "name": "claude-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mundo en vivo de lo que hace Claude Code: sesiones, subagentes, skills y herramientas en tiempo real",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "demo": "tsx tools/demo.ts",
    "screenshot": "tsx tools/screenshot.ts",
    "test:parser": "tsx server/test/parser.smoke.ts",
    "test:grouping": "tsx server/test/grouping.smoke.ts",
    "test": "npm run test:parser && npm run test:grouping && npm run test:store",
    "test:store": "tsx web/test/store.smoke.ts",
    "server": "bash scripts/claude-live.sh"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.0",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
